{
  "permissions": {
    "deny": [
      "Read(./pat.txt)",
      "Read(./*.keystore)",
      "Read(./*.jks)",
      "Read(./.env*)",
      "Read(./android-build/**)",
      "Read(./dist/**)",
      "Read(./node_modules/**)",
      "Read(./.idea/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/format-edited.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/check.sh\" --hook",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
